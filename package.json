{
  "name": "arkos",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema de gestão para farmácia — MVP",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "sync:schema": "node database/scripts/sync-schema.js",
    "migrate": "node database/scripts/run-migrations.js",
    "seed": "node database/scripts/seed.js",
    "seed:demo": "node database/scripts/seed-demo.js",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "test:fluxo": "node scripts/teste-fluxo-mvp.mjs",
    "dev:impressora": "node --env-file=.env node_modules/escpos-emulator/dist/index.js",
    "test:integracao": "node scripts/teste-integracao.mjs",
    "test:telas": "npm run testar:telas --workspace=apps/web",
    "test:pdf": "node apps/api/testes/layout-da-ordem.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "concurrently": "^10.0.5",
    "escpos-emulator": "^0.2.0"
  }
}
