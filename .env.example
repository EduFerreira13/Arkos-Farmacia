# Copie para .env e preencha com valores reais. Nunca commitar o .env preenchido.

DATABASE_URL=postgres://usuario:senha@host:porta/nome_do_banco

# Porta do backend (processo unico, apps/api). Nada no codigo depende dela
# diretamente: o proprio backend, o proxy do Vite e os scripts de teste leem
# esta variavel, entao mudar aqui muda nos tres de uma vez.
#
# Vale mexer quando outro programa da maquina ja estiver ouvindo na porta. O
# sintoma e a requisicao ficar pendurada ate estourar o tempo em vez de dar
# "conexao recusada" — dois processos conseguem se registrar na mesma porta no
# Windows, e o outro fica com a conexao. Para descobrir quem esta la:
#   Get-NetTCPConnection -LocalPort 3000 -State Listen | ForEach-Object {
#     Get-Process -Id $_.OwningProcess }
PORT=3000
WEB_PORT=5173

# Única origem aceita pelo CORS do backend. Em dev aponta pro Vite; em
# producao, a URL real onde o frontend fica publicado.
FRONTEND_URL=http://localhost:5173

REDIS_URL=redis://localhost:6379

# Fuso do negocio: define quando o dia da farmacia comeca e termina
# (dashboard, fechamento de caixa, alertas de validade).
TZ_NEGOCIO=America/Sao_Paulo

JWT_SECRET=defina-um-segredo-forte-aqui
JWT_EXPIRES_IN=8h

NODE_ENV=development

# Identificacao da farmacia impressa na ordem de compra (PDF do compras-service)
# e no recibo do PDV (vendas-service). Nao e segredo: e o que ja vai no
# documento que chega ao fornecedor/cliente.
FARMACIA_NOME=Farmacia Arkos
FARMACIA_CNPJ=
FARMACIA_ENDERECO=
FARMACIA_TELEFONE=

# Impressora termica do PDV (ESC/POS), lida pelo modulo de vendas. Em dev, aponta
# para o emulador local: `npm run dev:impressora` na raiz sobe um servidor TCP
# na porta 9100 e mostra o recibo em http://localhost:3100 (HTTP_PORT abaixo —
# nao pode ser 3000, que agora e o backend). Quando a impressora fisica
# chegar, troca so esta variavel (ex: tcp://192.168.0.50:9100).
PRINTER_URL=tcp://localhost:9100

# Preview HTML do emulador de impressora (ver PRINTER_URL acima). So existe
# porque o backend passou a ocupar a porta 3000, que era o padrao da lib.
HTTP_PORT=3100
